# MongoDB Connection
# Get this from: https://cloud.mongodb.com → Connection → Drivers
# Format: mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_URI=mongodb+srv://YOUR_MONGODB_USER:YOUR_MONGODB_PASSWORD@YOUR_CLUSTER.mongodb.net/
MONGODB_DB_NAME=sahad_stores

# JWT Configuration (already generated for you)
JWT_SECRET=497370d26afccf8ceaa8b6e874be91ef6c4b4b5e1050113517b483e2e0d7acc6eed8101ae505c3a0143ef9089209ced0

# Server Configuration
NODE_ENV=development
PORT=3000

# Monnify Payment Gateway (if configured)
# MONNIFY_API_KEY=your_key
# MONNIFY_SECRET_KEY=your_secret
# MONNIFY_CONTRACT_CODE=your_contract_code

